{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "netremote",
  "version-string": "0.5.2",
  "builtin-baseline": "588319964489874699b378e3a94b4285126e112e",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "api",
    "api-bindings",
    "server",
    "tests",
    "tools"
  ],
  "features": {
    "api": {
      "description": "Provide the API protocol buffers + gRPC .proto source files"
    },
    "api-bindings": {
      "description": "Provide the API protocol buffers + gRPC library bindings",
      "dependencies": [
        "grpc",
        "protobuf"
      ]
    },
    "server": {
      "description": "Provide the server binary",
      "dependencies": [
        "cli11",
        "grpc",
        {
          "name": "libsystemd",
          "platform": "linux"
        },
        "magic-enum",
        "nlohmann-json",
        "plog",
        "protobuf",
        {
          "name": "sdbus-cpp",
          "platform": "linux"
        }
      ]
    },
    "tests": {
      "description": "Enable building the tests",
      "dependencies": [
        "catch2",
        "cli11",
        "grpc",
        {
          "name": "libsystemd",
          "platform": "linux"
        },
        "magic-enum",
        "nlohmann-json",
        "plog",
        "protobuf",
        {
          "name": "sdbus-cpp",
          "platform": "linux"
        }
      ]
    },
    "tools": {
      "description": "Enable building the tools",
      "dependencies": [
        "cli11",
        "grpc",
        {
          "name": "libsystemd",
          "platform": "linux"
        },
        "magic-enum",
        "nlohmann-json",
        "plog",
        "protobuf",
        {
          "name": "sdbus-cpp",
          "platform": "linux"
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "cli11",
      "version": "2.3.1"
    }
  ]
}
